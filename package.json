{
  "name": "md-table-tools",
  "displayName": "Markdown Table Tools",
  "description": "%extension.description%",
  "categories": [
    "Visualization",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "markdown",
    "table",
    "preview",
    "editor",
    "sort",
    "filter"
  ],
  "version": "0.0.5",
  "publisher": "hrk-ymkw",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hrk-ymkw/md-table-tools"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "scripts": {
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node test/run-integration.js",
    "test:e2e": "node test/e2e/run.js",
    "test:vsix": "node test/run-integration.js --vsix",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "ovsx": "1.3.0",
    "playwright-core": "1.64.1"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "md-table-tools.openTablePreview",
        "title": "%command.openTablePreview%",
        "icon": "$(table)"
      }
    ],
    "keybindings": [
      {
        "command": "md-table-tools.openTablePreview",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorLangId == markdown"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "md-table-tools.openTablePreview",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "md-table-tools.openTablePreview",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Table Tools",
      "properties": {
        "mdTableTools.openIn": {
          "type": "string",
          "enum": ["active", "beside"],
          "default": "active",
          "description": "%config.openIn%"
        },
        "mdTableTools.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoSave%"
        }
      }
    },
    "markdown.previewScripts": [
      "./media/i18n.js",
      "./media/preview.js"
    ],
    "markdown.previewStyles": [
      "./media/preview.css"
    ],
    "markdown.markdownItPlugins": true
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
